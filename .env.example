# Hostinger Production Environment Configuration
# Copy this file to .env on your Hostinger server or set in hPanel Environment Variables.

# --- Server-Side Secret Keys (NEVER expose to the browser) ---
# Required for AI Features via Hostinger PHP Proxy (/api/gemini.php)
GEMINI_API_KEY=

# --- Hostinger MySQL Database (Optional for PHP API backend) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# --- Firebase Authentication Configuration (Web SDK) ---
# Retrieve from Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- Frontend Build Configuration (Vite) ---
# Base path for deployment (use '/' for public_html root or '/subfolder/' for subdirectories)
VITE_BASE_PATH=/

# AI Proxy API endpoint (defaults to '/api/gemini.php' hosted on same domain)
VITE_AI_API_URL=/api/gemini.php

# Tally Prime XML/ODBC Server URL (Optional, e.g., 'http://localhost:9000')
VITE_TALLY_SERVER_URL=
